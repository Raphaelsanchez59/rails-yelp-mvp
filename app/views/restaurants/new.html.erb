<%= simple_form_for(@restaurant) do |f| %>
  <%= f.input :name %>
  <%= f.input :address %>
  <%= f.input :phone_number %>
  <%= f.input :category, collection: ["chinese", "italian", "japanese", "french", "belgian"] %>
  <%= f.submit "Créer le restaurant", class: "btn btn-primary" %>
<% end %>

<div class="mt-3">
    <%= link_to "Retour à la liste", restaurants_path, class: "btn btn-secondary" %>
  </div>
</div>
