<div class="container mt-5">
  <h1>Ajouter un avis pour <%= @restaurant.name %></h1>

  <%= simple_form_for([@restaurant, @review]) do |f| %>
    <%= f.input :content, label: "Votre avis" %>
    <%= f.input :rating, label: "Note (de 0 à 5)", collection: 0..5 %>
    <%= f.submit "Envoyer l'avis", class: "btn btn-primary" %>
  <% end %>

  <div class="mt-3">
    <%= link_to "Retour au restaurant", restaurant_path(@restaurant), class: "btn btn-secondary" %>
  </div>
</div>
